# =============================================================
# ORIZZONTE — variables d'environnement
#
#   1. Copier ce fichier vers .env   (Windows : copy .env.example .env)
#   2. Remplir les valeurs
#   3. Redémarrer le serveur
#
# .env est déjà dans .gitignore → il ne sera JAMAIS commité.
# Ne jamais mettre de mot de passe directement dans settings.py.
# =============================================================

# --- Sécurité -------------------------------------------------
# Générer avec : python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-generate-a-real-one
DEBUG=True

# --- Hôtes autorisés -----------------------------------------
# Dev / démo téléphone : *  (ou * ,192.168.1.20)
# Production           : mon-domaine.com
ALLOWED_HOSTS=*

# --- URL publique du backend (lien de vérification email) -----
# Démo sur le même Wi-Fi : mettre l'IP de ce PC (ipconfig → Adresse IPv4)
#   http://192.168.1.20:8000
# Émulateur Android      : http://10.0.2.2:8000
# Production             : https://mon-domaine.com
SITE_URL=http://127.0.0.1:8000

# --- Base de données ------------------------------------------
# Optionnel. Par défaut : db.sqlite3 à côté de manage.py.
# Utile pour lancer une commande sur une COPIE sans toucher la vraie base :
#   DB_NAME=db.copy.sqlite3
# (laisser vide = utiliser db.sqlite3)
# DB_NAME=

# --- Compte boss (créé uniquement côté serveur) ---------------
# Le boss ne peut JAMAIS être créé via /api/signup/ (l'API refuse le rôle
# "boss"). Il se crée en ligne de commande :
#
#   python manage.py create_boss --email boss@exemple.com
#
# Le mot de passe est demandé en saisie masquée (jamais affiché, jamais loggé).
# Pour un script non interactif, on peut fournir le mot de passe via cette
# variable d'environnement — NE JAMAIS la commiter ni la partager :
# BOSS_PASSWORD=


# --- Email : développement (par défaut) -----------------------
# Les emails s'affichent dans le terminal Django. Gratuit, aucun compte requis.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# --- Email : production — Gmail (mot de passe d'application) --
# 1. Activer la validation en 2 étapes : https://myaccount.google.com/security
# 2. Créer un mot de passe d'application : https://myaccount.google.com/apppasswords
# 3. Décommenter les lignes ci-dessous et remplir.
#
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=votre.adresse@gmail.com
# EMAIL_HOST_PASSWORD=abcdefghijklmnop
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=ORIZZONTE <votre.adresse@gmail.com>


# =============================================================
# Documents des conducteurs — stockage PRIVÉ
# =============================================================
# Dossier ABSOLU où sont écrites les pièces d'identité (permis, carte
# grise, selfie...). Il ne doit JAMAIS être servi par Django ni se trouver
# dans STATIC_ROOT / STATICFILES_DIRS.
#
# Obligatoire : sans cette variable le serveur refuse de démarrer
# (system check "drivers.E001"). Il n'y a pas de valeur par défaut :
# des documents d'identité ne doivent jamais atterrir à un endroit implicite.
#
# Windows :  PRIVATE_MEDIA_ROOT=C:/orizzonte/private_media
# Linux   :  PRIVATE_MEDIA_ROOT=/var/lib/orizzonte/private_media
PRIVATE_MEDIA_ROOT=

# Taille maximale d'un document téléversé, en Mo (défaut : 5).
MAX_UPLOAD_MB=5


# =============================================================
# Agent IA de validation des documents (service externe)
# =============================================================
# Clé partagée envoyée dans l'en-tête HTTP "X-Agent-Key". Comparée en temps
# constant. Laisser VIDE désactive complètement les endpoints /api/agent/.
# Cette clé ne doit jamais être loggée ni commitée.
# Générer par ex. : python -c "import secrets; print(secrets.token_urlsafe(48))"
AI_AGENT_API_KEY=

# Si False (défaut) : un "approve" de l'agent n'est qu'une RECOMMANDATION,
# le profil reste en attente d'une décision du boss.
# Si True : l'agent peut approuver automatiquement, mais uniquement si sa
# confiance est >= AI_AUTO_APPROVE_MIN_CONFIDENCE.
AI_AUTO_APPROVE=False
AI_AUTO_APPROVE_MIN_CONFIDENCE=0.90
